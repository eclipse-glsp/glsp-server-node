{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build glsp-server packages",
      "type": "shell",
      "group": "build",
      "command": "pnpm",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": ["$tsc", "$eslint-stylish"]
    },
    {
      "label": "Start Example GLSP server (dev, hot reload)",
      "type": "shell",
      "group": "none",
      "command": "pnpm dev",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Execute all glsp-server tests",
      "type": "shell",
      "group": "test",
      "command": "pnpm test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Example GLSP server",
      "type": "shell",
      "group": "none",
      "command": "pnpm start",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
